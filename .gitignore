# Raw deposits and AR6 data: cited by DOI and hashed in DATA.md, not tracked.
# Every commit before the v16 clean-up of 24 October 2026 contains them (the World
# CSV via Git LFS), so the repository stays private; the AR6 licence restricts
# redistribution.
data/raw/

# Machine-specific paths; config/local_paths.example.yaml is the committed template
config/local_paths.yaml

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# LaTeX build artefacts. The frozen v1.0 PDF is added once, with: git add -f protocol/preregistration.pdf
protocol/*.aux
protocol/*.log
protocol/*.out
protocol/*.synctex.gz
protocol/*.pdf

# OS
.DS_Store

# Local archive of superseded working folders
archive/
